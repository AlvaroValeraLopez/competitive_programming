---
// Cuadrícula interactiva para el problema 15: cada punto muestra cuántos caminos
// llegan a él desde la esquina superior izquierda (el triángulo de Pascal girado)
// y se puede dibujar un camino al azar.
interface Props {
	initial?: number;
	max?: number;
}

const { initial = 4, max = 8 } = Astro.props;
---

<lattice-paths class="lattice not-content" data-initial={initial}>
	<div class="controls">
		<label>
			Cuadrícula de <output data-size>{initial} × {initial}</output>
			<input type="range" min="1" max={max} value={initial} data-slider />
		</label>
		<button type="button" data-random>Dibujar un camino al azar</button>
	</div>
	<svg data-svg role="img" aria-label="Cuadrícula con el número de caminos que llegan a cada punto"
	></svg>
	<p class="word" data-word aria-live="polite">&nbsp;</p>
	<p class="total" data-total></p>
</lattice-paths>

<script>
	const SVG_NS = 'http://www.w3.org/2000/svg';
	const CELL = 56;
	const PAD = 28;

	// Fórmula multiplicativa: cada resultado intermedio es un entero, así que
	// con estos tamaños el cálculo en coma flotante es exacto.
	function binomial(n: number, k: number): number {
		let result = 1;
		for (let i = 1; i <= k; i++) result = (result * (n - k + i)) / i;
		return result;
	}

	function svgElement(tag: string, attrs: Record<string, string | number>) {
		const el = document.createElementNS(SVG_NS, tag);
		for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));
		return el;
	}

	class LatticePaths extends HTMLElement {
		n = 4;
		svg!: SVGSVGElement;
		word!: HTMLElement;
		total!: HTMLElement;
		size!: HTMLElement;

		connectedCallback() {
			this.n = Number(this.dataset.initial ?? 4);
			this.svg = this.querySelector('[data-svg]')!;
			this.word = this.querySelector('[data-word]')!;
			this.total = this.querySelector('[data-total]')!;
			this.size = this.querySelector('[data-size]')!;

			const slider = this.querySelector<HTMLInputElement>('[data-slider]')!;
			slider.addEventListener('input', () => {
				this.n = Number(slider.value);
				this.render();
			});
			this.querySelector('[data-random]')!.addEventListener('click', () => this.drawRandomPath());
			this.render();
		}

		point(i: number, j: number) {
			return { x: PAD + i * CELL, y: PAD + j * CELL };
		}

		render() {
			const n = this.n;
			const side = 2 * PAD + n * CELL;
			this.svg.setAttribute('viewBox', `0 0 ${side} ${side}`);
			this.svg.replaceChildren();
			this.size.textContent = `${n} × ${n}`;
			this.word.innerHTML = '&nbsp;';

			for (let k = 0; k <= n; k++) {
				const a = this.point(0, k);
				const b = this.point(n, k);
				this.svg.append(svgElement('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: 'grid' }));
				const c = this.point(k, 0);
				const d = this.point(k, n);
				this.svg.append(svgElement('line', { x1: c.x, y1: c.y, x2: d.x, y2: d.y, class: 'grid' }));
			}

			// Capa para el camino, debajo de las etiquetas.
			this.svg.append(svgElement('g', { 'data-path-layer': '' }));

			for (let j = 0; j <= n; j++) {
				for (let i = 0; i <= n; i++) {
					const { x, y } = this.point(i, j);
					const label = svgElement('text', {
						x,
						y,
						class: i === n && j === n ? 'count goal' : 'count',
						'data-node': `${i},${j}`,
					});
					label.textContent = String(binomial(i + j, i));
					this.svg.append(label);
				}
			}

			const total = binomial(2 * n, n);
			this.total.innerHTML =
				`Caminos de la esquina superior izquierda a la inferior derecha: ` +
				`C(${2 * n}, ${n}) = <strong>${total.toLocaleString('es-ES')}</strong>`;
		}

		drawRandomPath() {
			const n = this.n;
			// Barajar n flechas → y n flechas ↓ da cada camino con la misma probabilidad.
			const moves = [...Array(n).fill('→'), ...Array(n).fill('↓')];
			for (let k = moves.length - 1; k > 0; k--) {
				const r = Math.floor(Math.random() * (k + 1));
				[moves[k], moves[r]] = [moves[r], moves[k]];
			}

			let i = 0;
			let j = 0;
			const visited = ['0,0'];
			const points = [this.point(0, 0)];
			for (const move of moves) {
				if (move === '→') i++;
				else j++;
				visited.push(`${i},${j}`);
				points.push(this.point(i, j));
			}

			const layer = this.svg.querySelector('[data-path-layer]')!;
			layer.replaceChildren(
				svgElement('polyline', {
					points: points.map((p) => `${p.x},${p.y}`).join(' '),
					class: 'path',
				}),
			);
			this.svg.querySelectorAll('.count').forEach((el) => {
				el.classList.toggle('on-path', visited.includes(el.getAttribute('data-node')!));
			});
			this.word.textContent = moves.join(' ');
		}
	}

	customElements.define('lattice-paths', LatticePaths);
</script>

<style is:global>
	lattice-paths.lattice {
		display: block;
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--euler-radio);
		box-shadow: var(--euler-sombra);
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
	}
	lattice-paths .controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		font-size: var(--sl-text-sm);
	}
	lattice-paths label {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	lattice-paths output {
		min-width: 3.5rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	lattice-paths input[type='range'] {
		accent-color: var(--sl-color-accent);
	}
	lattice-paths button {
		padding: 0.45rem 1rem;
		border: 1px solid var(--euler-boton-borde);
		border-radius: var(--euler-radio);
		background: var(--euler-boton);
		color: #ffffff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 2px 4px rgba(var(--euler-sombra-rgb), 0.2);
	}
	lattice-paths button:hover {
		background: var(--euler-boton-hover);
	}
	lattice-paths svg {
		display: block;
		width: 100%;
		max-width: 26rem;
		margin: 1rem auto 0.5rem;
	}
	lattice-paths .grid {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	lattice-paths .path {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 7;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.6;
	}
	lattice-paths .count {
		font-family: var(--sl-font-mono);
		font-size: 13px;
		text-anchor: middle;
		dominant-baseline: central;
		fill: var(--sl-color-gray-2);
		paint-order: stroke;
		stroke: var(--sl-color-gray-7, var(--sl-color-gray-6));
		stroke-width: 5;
		stroke-linejoin: round;
	}
	lattice-paths .count.on-path {
		fill: var(--sl-color-white);
		font-weight: 700;
	}
	lattice-paths .count.goal {
		fill: var(--sl-color-accent-high);
		font-weight: 700;
	}
	lattice-paths .word {
		min-height: 1.5em;
		margin: 0;
		text-align: center;
		font-family: var(--sl-font-mono);
		letter-spacing: 0.05em;
	}
	lattice-paths .total {
		margin: 0.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
	}
</style>
