---
// Sustituye al Hero de Starlight: texto y botones a la izquierda y la
// ilustración a la derecha, como la portada de Exercism. Lee los mismos datos
// del frontmatter (`hero`) que el original.
import { LinkButton } from '@astrojs/starlight/components';
import Ilustracion from './portada/Ilustracion.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="heroe">
	<div class="texto">
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="lema" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="acciones">
					{actions.map(({ attrs, icon, link, text, variant }) => (
						<LinkButton href={link} variant={variant} icon={icon?.name} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<Ilustracion />
</section>

<style>
	.heroe {
		display: grid;
		gap: 3rem;
		align-items: center;
		padding-block: 2.5rem 1rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.lema {
		margin: 1.25rem 0 0;
		max-width: 34rem;
		font-size: var(--sl-text-xl);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
	.acciones :global(.sl-link-button) {
		padding: 0.85rem 1.4rem;
		font-size: 1.0625rem;
	}
	@media (min-width: 64rem) {
		.heroe {
			grid-template-columns: 1.15fr 1fr;
			padding-block: 4rem 2rem;
		}
	}
</style>
