---
// Tarjeta de un problema o un concepto, al estilo de las tarjetas de ejercicios
// de Exercism. Se usa en la portada y en los catálogos, dentro de una
// `<ul class="rejilla-tarjetas">`. Los atributos extra van al `<li>`.
import type { HTMLAttributes } from 'astro/types';
import type { PaginaContenido } from '../lib/paginas';

interface Props extends HTMLAttributes<'li'> {
	pagina: PaginaContenido;
	compacta?: boolean;
}

const { pagina, compacta = false, ...atributos } = Astro.props;
const { href, numero, etiqueta, descripcion, temas } = pagina;
---

<li {...atributos}>
	<a href={href} class:list={{ compacta }}>
		<span class="cabecera">
			{numero !== undefined && <span class="numero">{numero}</span>}
			<span class="titulo">{etiqueta}</span>
		</span>
		{descripcion && <span class="descripcion">{descripcion}</span>}
		{
			temas.length > 0 && (
				<span class="temas">
					{temas.map((tema) => (
						<span>{tema}</span>
					))}
				</span>
			)
		}
	</a>
</li>

<style>
	a {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		height: 100%;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: var(--sl-color-text);
		text-decoration: none;
		transition:
			box-shadow 0.15s,
			border-color 0.15s,
			transform 0.15s;
	}
	a:hover {
		border-color: var(--sl-color-accent);
		box-shadow: var(--euler-sombra-grande);
		transform: translateY(-2px);
	}
	a.compacta {
		padding: 1rem 1.25rem;
	}
	.cabecera {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	.numero {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--euler-radio);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 700;
	}
	.titulo {
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.descripcion {
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.temas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: auto;
	}
	.temas span {
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999rem;
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		color: var(--sl-color-gray-1);
	}
</style>
