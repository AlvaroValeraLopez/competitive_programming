---
// Lista de ejercicios al estilo de la de Exercism: tarjetas con la fuente, el
// número, el título, la dificultad, la descripción y los conceptos que usa cada
// ejercicio, con colores por dominio. Se filtra por dificultad (pestañas), por
// tema, concepto y fuente (un panel compacto) y por texto, y se ordena por
// fuente o por dificultad. El recuento de cada opción se recalcula con el resto
// del filtro. El filtro se guarda en la dirección
// (`?dificultad=facil&tema=teoria-de-numeros&conceptos=a,b&q=…`), así que
// cualquier selección es una página que se puede enlazar.
import { Icon } from '@astrojs/starlight/components';
import Dificultad from './Dificultad.astro';
import { DIFICULTADES, rangoDeDificultad } from '../lib/dificultad';
import { slugDeTema, type Grupo } from '../lib/filtro';
import { FUENTES, ID_FUENTES, prefijoDeEjercicio } from '../lib/fuentes';
import { agruparEjercicios, AREAS, dominioDe, normalizar } from '../lib/menu';
import { obtenerPaginas, type PaginaContenido } from '../lib/paginas';
import { obtenerGrafo } from '../lib/relaciones';
import { trackDeDominio } from '../lib/tracks';

interface Props {
	/** En la página de un track: solo los ejercicios que usan conceptos de su
	 * dominio, y solo sus temas y conceptos como filtro. */
	dominio?: string;
}

const { dominio } = Astro.props;
const todo = await obtenerPaginas();
const grafo = await obtenerGrafo();

const slug = (id: string) => id.replace(/^conceptos\//, '');
const conceptoPorId = new Map(todo.conceptos.map((c) => [c.id, c]));
const trackDe = (concepto: string) => trackDeDominio(conceptoPorId.get(concepto)?.dominio)?.slug;
const conceptosDe = (id: string) => grafo.nodos.get(id)?.padres ?? [];
const areasDe = (id: string) => [
	...new Set(conceptosDe(id).map((c) => conceptoPorId.get(c)?.area).filter((a): a is string => a !== undefined)),
];
const conceptos = dominio ? todo.conceptos.filter((c) => c.dominio === dominio) : todo.conceptos;
const delDominio = new Set(conceptos.map((c) => c.id));
const problemas = dominio ? todo.problemas.filter((p) => conceptosDe(p.id).some((c) => delDominio.has(c))) : todo.problemas;
const total = problemas.length;

// Las opciones de cada grupo que cumple cada ejercicio. Su tema es el área de
// sus conceptos («Teoría de números»…), así que puede tener varios.
const valoresDe = (p: PaginaContenido): Record<Grupo, string[]> => ({
	dificultad: p.dificultad ? [p.dificultad] : [],
	tema: areasDe(p.id).map(slugDeTema),
	conceptos: conceptosDe(p.id).map(slug),
	fuente: p.fuente ? [p.fuente] : [],
});
const valores = new Map(problemas.map((p) => [p.id, valoresDe(p)]));
const cuantos = (grupo: Grupo, opcion: string) => problemas.filter((p) => valores.get(p.id)![grupo].includes(opcion)).length;
const deMasAMenos = <T extends { cuenta: number }>(a: T, b: T) => b.cuenta - a.cuenta;

// Las opciones de cada grupo, con cuántos ejercicios las cumplen sin filtro (el
// script los recalcula con cada cambio). Un grupo con una sola opción no filtra
// nada, así que no se muestra.
const dificultades = DIFICULTADES.map((d) => ({ ...d, cuenta: cuantos('dificultad', d.id) }));
// Los temas de la lista (en un track, solo los suyos), de más a menos ejercicios.
const temas = AREAS.filter((a) => conceptos.some((c) => c.area === a))
	.map((a) => ({ id: slugDeTema(a), nombre: a, track: trackDeDominio(dominioDe(a))?.slug, cuenta: cuantos('tema', slugDeTema(a)) }))
	.filter((o) => o.cuenta > 0)
	.sort(deMasAMenos);
// Los conceptos que usa algún ejercicio, por tema y de más a menos ejercicios.
// Solo se ven los de los temas elegidos.
const conceptosPorTema = temas.flatMap((t) =>
	conceptos
		.filter((c) => c.area === t.nombre)
		.map((c) => ({ id: slug(c.id), nombre: c.etiqueta, tema: t.id, cuenta: cuantos('conceptos', slug(c.id)) }))
		.filter((o) => o.cuenta > 0)
		.sort(deMasAMenos),
);
const fuentes = ID_FUENTES.map((id) => ({ id, nombre: FUENTES[id].nombre, cuenta: cuantos('fuente', id) })).filter(
	(o) => o.cuenta > 0,
);

const vistas = [
	temas.length > 0 && 'tema',
	conceptosPorTema.length > 0 && 'concepto',
	fuentes.length > 1 && 'fuente',
].filter((v): v is string => Boolean(v));
const resumenPanel = `Filtrar por ${vistas.slice(0, -1).join(', ')}${vistas.length > 1 ? ' o ' : ''}${vistas.at(-1) ?? ''}`;

// Una sola rejilla, como la de Exercism, en el orden por fuente y número; cada
// tarjeta ya dice su fuente y su dificultad.
const ordenados = agruparEjercicios(problemas).flatMap((f) => f.ejercicios);
---

<lista-problemas class="ejercicios not-content">
	<div class="barra">
		<label class="buscador">
			<Icon name="magnifier" size="1.1rem" />
			<span class="sr-only">Buscar ejercicios</span>
			<input type="search" placeholder="Buscar por número, título o tema" autocomplete="off" data-buscador />
		</label>
		<label class="orden">
			<span>Ordenar</span>
			<select data-orden>
				<option value="fuente">Por fuente y número</option>
				<option value="dificultad">Por dificultad</option>
			</select>
		</label>
	</div>

	<div class="pestanas" role="group" aria-label="Dificultad">
		<button type="button" aria-pressed="true" data-todas>
			Todas <span class="cuenta" data-cuenta>{total}</span>
		</button>
		{
			dificultades.map((d) => (
				<button
					type="button"
					aria-pressed="false"
					data-grupo="dificultad"
					data-opcion={d.id}
					data-etiqueta={d.nombre}
					data-unica
					data-dificultad={d.id}
					disabled={d.cuenta === 0}
				>
					<span class="punto" aria-hidden="true" />
					{d.nombre}
					<span class="cuenta" data-cuenta>
						{d.cuenta}
					</span>
				</button>
			))
		}
	</div>

	{
		vistas.length > 0 && (
			<details class="panel" data-panel>
				<summary>
					<Icon name="setting" size="1rem" />
					{resumenPanel}
					<span class="activos-panel" hidden data-activos-panel />
				</summary>
				<div class="filas">
					{temas.length > 0 && (
						<div class="fila" role="group" aria-labelledby="filtro-tema">
							<span class="nombre-fila" id="filtro-tema">
								Tema
							</span>
							<div class="chips">
								{temas.map((o) => (
									<button type="button" class="chip" aria-pressed="false" data-grupo="tema" data-opcion={o.id} data-etiqueta={o.nombre} data-track={o.track}>
										<span class="punto" aria-hidden="true" />
										{o.nombre}
										<span class="usos" data-cuenta>
											{o.cuenta}
										</span>
									</button>
								))}
							</div>
						</div>
					)}
					{conceptosPorTema.length > 0 && (
						<div class="fila" role="group" aria-labelledby="filtro-concepto" data-fila-conceptos>
							<span class="nombre-fila" id="filtro-concepto">
								Concepto
								<span class="de-temas" data-de-temas />
							</span>
							<div class="chips">
								<p class="pista" data-pista>
									Elige un tema para ver sus conceptos.
								</p>
								{conceptosPorTema.map((o) => (
									<button type="button" class="chip" aria-pressed="false" hidden data-grupo="conceptos" data-opcion={o.id} data-etiqueta={o.nombre} data-tema={o.tema}>
										{o.nombre}
										<span class="usos" data-cuenta>
											{o.cuenta}
										</span>
									</button>
								))}
							</div>
						</div>
					)}
					{fuentes.length > 1 && (
						<div class="fila" role="group" aria-labelledby="filtro-fuente">
							<span class="nombre-fila" id="filtro-fuente">
								Fuente
							</span>
							<div class="chips">
								{fuentes.map((o) => (
									<button type="button" class="chip" aria-pressed="false" data-grupo="fuente" data-opcion={o.id} data-etiqueta={o.nombre}>
										{o.nombre}
										<span class="usos" data-cuenta>
											{o.cuenta}
										</span>
									</button>
								))}
							</div>
						</div>
					)}
				</div>
			</details>
		)
	}

	<div class="estado">
		<p class="recuento" aria-live="polite" data-recuento>{total} ejercicios</p>
		<ul class="activos" aria-label="Filtros activos" data-activos></ul>
		<button type="button" class="limpiar" hidden data-limpiar>
			<Icon name="close" size="0.9rem" />
			Quitar filtros
		</button>
	</div>

	<div class="rejilla">
		{
			ordenados.map((p, posicion) => {
				const usados = conceptosDe(p.id);
				return (
					<article
						class="ejercicio"
						data-ejercicio
						data-posicion={posicion}
						data-numero={p.numero ?? ''}
						data-rango={rangoDeDificultad(p.dificultad)}
						data-texto={normalizar([p.numero, p.etiqueta, p.descripcion, ...p.temas, ...areasDe(p.id)].filter(Boolean).join(' '))}
						data-valores={JSON.stringify(valores.get(p.id))}
					>
						<div class="contenido">
							<div class="cabecera">
								<span class="insignia" aria-hidden="true">
									{p.numero ?? p.etiqueta.slice(0, 2)}
								</span>
								<div class="titular">
									<h2>
										<a href={p.href} class="enlace">
											<span class="sr-only">{prefijoDeEjercicio(p)}</span>
											{p.etiqueta}
										</a>
									</h2>
									<p class="meta">
										{p.fuente && <span class="fuente">{FUENTES[p.fuente as keyof typeof FUENTES].nombre}</span>}
										{p.dificultad && <Dificultad dificultad={p.dificultad} />}
									</p>
								</div>
							</div>
							<p class="descripcion">{p.descripcion}</p>
						</div>
						<div class="pie">
							{usados.length > 0 && (
								<ul class="usa" aria-label="Conceptos que usa">
									{usados.map((c) => (
										<li>
											<button
												type="button"
												aria-pressed="false"
												data-grupo="conceptos"
												data-opcion={slug(c)}
												data-etiqueta={conceptoPorId.get(c)?.etiqueta}
												data-track={trackDe(c)}
												title="Filtrar por este concepto"
											>
												{conceptoPorId.get(c)?.etiqueta}
											</button>
										</li>
									))}
								</ul>
							)}
						</div>
					</article>
				);
			})
		}
	</div>

	<p class="vacio" hidden data-vacio>Ningún ejercicio coincide con el filtro.</p>
</lista-problemas>

<script>
	import {
		alternar,
		elegirSolo,
		escribirFiltro,
		FILTRO_VACIO,
		filtrar,
		GRUPOS,
		hayFiltro,
		leerFiltro,
		recuento,
		type Filtro,
		type Grupo,
		type Orden,
	} from '../lib/filtro';

	const ejercicios = (n: number) => `${n} ${n === 1 ? 'ejercicio' : 'ejercicios'}`;
	const enumerar = (nombres: string[]) =>
		nombres.length > 1 ? `${nombres.slice(0, -1).join(', ')} y ${nombres.at(-1)}` : (nombres[0] ?? '');

	class ListaProblemas extends HTMLElement {
		connectedCallback() {
			const buscador = this.querySelector<HTMLInputElement>('[data-buscador]')!;
			const orden = this.querySelector<HTMLSelectElement>('[data-orden]')!;
			const todas = this.querySelector<HTMLButtonElement>('[data-todas]')!;
			const activosPanel = this.querySelector<HTMLElement>('[data-activos-panel]');
			const textoRecuento = this.querySelector<HTMLElement>('[data-recuento]')!;
			const activos = this.querySelector<HTMLElement>('[data-activos]')!;
			const limpiar = this.querySelector<HTMLButtonElement>('[data-limpiar]')!;
			const vacio = this.querySelector<HTMLElement>('[data-vacio]')!;
			const botones = [...this.querySelectorAll<HTMLButtonElement>('button[data-grupo]')];
			// Las opciones del panel y de las pestañas llevan su recuento; las etiquetas
			// de concepto de las tarjetas, no.
			const conRecuento = botones.filter((b) => b.querySelector('[data-cuenta]'));
			const conceptosDelPanel = [...this.querySelectorAll<HTMLButtonElement>('[data-fila-conceptos] button[data-grupo]')];
			const temaDeConcepto = new Map(conceptosDelPanel.map((b) => [b.dataset.opcion!, b.dataset.tema!]));
			const deTemas = this.querySelector<HTMLElement>('[data-de-temas]');
			const pista = this.querySelector<HTMLElement>('[data-pista]');
			const tarjetas = [...this.querySelectorAll<HTMLElement>('[data-ejercicio]')].map((elemento) => ({
				elemento,
				posicion: Number(elemento.dataset.posicion),
				numero: elemento.dataset.numero ? Number(elemento.dataset.numero) : undefined,
				rango: Number(elemento.dataset.rango),
				texto: elemento.dataset.texto!,
				valores: JSON.parse(elemento.dataset.valores!) as Record<Grupo, string[]>,
			}));

			const grupoDe = (b: HTMLElement) => b.dataset.grupo as Grupo;
			const conocidas = Object.fromEntries(GRUPOS.map((g) => [g, new Set<string>()])) as Record<Grupo, Set<string>>;
			const etiquetas = new Map<string, string>();
			for (const b of botones) {
				conocidas[grupoDe(b)].add(b.dataset.opcion!);
				etiquetas.set(`${b.dataset.grupo}:${b.dataset.opcion}`, b.dataset.etiqueta ?? b.dataset.opcion!);
			}

			let filtro: Filtro = leerFiltro(location.search, conocidas);
			buscador.value = filtro.consulta;
			orden.value = filtro.orden;

			const cambiar = (nuevo: Filtro) => {
				filtro = nuevo;
				aplicar();
			};

			// Los filtros activos (salvo la dificultad, que ya se ve en las pestañas),
			// cada uno con un botón para quitarlo.
			const pintarActivos = () => {
				const elegidos = GRUPOS.filter((g) => g !== 'dificultad').flatMap((g) =>
					filtro.seleccion[g].map((opcion) => ({ grupo: g, opcion })),
				);
				activos.replaceChildren(
					...elegidos.map(({ grupo, opcion }) => {
						const etiqueta = etiquetas.get(`${grupo}:${opcion}`) ?? opcion;
						const boton = document.createElement('button');
						boton.type = 'button';
						boton.textContent = etiqueta;
						boton.setAttribute('aria-label', `Quitar el filtro ${etiqueta}`);
						boton.addEventListener('click', () => cambiar(alternar(filtro, grupo, opcion)));
						const li = document.createElement('li');
						li.append(boton);
						return li;
					}),
				);
				if (activosPanel) {
					const n = elegidos.length;
					const texto = document.createElement('span');
					texto.className = 'sr-only';
					texto.textContent = n === 1 ? ' filtro activo' : ' filtros activos';
					activosPanel.replaceChildren(...(n > 0 ? [String(n), texto] : []));
					activosPanel.hidden = n === 0;
				}
			};

			const aplicar = (guardar = true) => {
				const activo = hayFiltro(filtro);
				// Las tarjetas visibles se colocan en el orden del filtro (CSS `order`).
				const visibles = filtrar(tarjetas, filtro);
				for (const t of tarjetas) {
					t.elemento.hidden = true;
					t.elemento.style.order = '';
				}
				visibles.forEach((t, i) => {
					t.elemento.hidden = false;
					t.elemento.style.order = String(i);
				});
				for (const b of botones) {
					b.setAttribute('aria-pressed', String(filtro.seleccion[grupoDe(b)].includes(b.dataset.opcion!)));
				}
				todas.setAttribute('aria-pressed', String(filtro.seleccion.dificultad.length === 0));
				// Cada opción dice cuántos ejercicios quedarían al elegirla, con el resto del
				// filtro; las que no dejarían ninguno se desactivan (salvo si ya están elegidas).
				for (const b of conRecuento) {
					const n = recuento(tarjetas, filtro, grupoDe(b), b.dataset.opcion);
					b.querySelector('[data-cuenta]')!.textContent = String(n);
					b.disabled = n === 0 && !filtro.seleccion[grupoDe(b)].includes(b.dataset.opcion!);
				}
				todas.querySelector('[data-cuenta]')!.textContent = String(recuento(tarjetas, filtro, 'dificultad'));
				// La fila de conceptos muestra los de los temas elegidos y los de los
				// conceptos que ya estén elegidos (por ejemplo, al llegar desde un concepto).
				const temasVisibles = [
					...new Set([
						...filtro.seleccion.tema,
						...filtro.seleccion.conceptos.map((c) => temaDeConcepto.get(c)).filter((t): t is string => t !== undefined),
					]),
				];
				for (const b of conceptosDelPanel) b.hidden = !temasVisibles.includes(b.dataset.tema!);
				if (pista) pista.hidden = temasVisibles.length > 0;
				if (deTemas) {
					const nombres = temasVisibles.map((t) => etiquetas.get(`tema:${t}`) ?? t);
					deTemas.textContent = nombres.length ? `de ${enumerar(nombres)}` : '';
				}
				pintarActivos();
				vacio.hidden = visibles.length > 0;
				limpiar.hidden = !activo;
				textoRecuento.textContent =
					visibles.length === tarjetas.length ? ejercicios(tarjetas.length) : `${visibles.length} de ${ejercicios(tarjetas.length)}`;
				if (guardar) history.replaceState(history.state, '', location.pathname + escribirFiltro(filtro) + location.hash);
			};

			buscador.addEventListener('input', () => cambiar({ ...filtro, consulta: buscador.value }));
			orden.addEventListener('change', () => cambiar({ ...filtro, orden: orden.value as Orden }));
			todas.addEventListener('click', () => cambiar(elegirSolo(filtro, 'dificultad')));
			for (const boton of botones) {
				boton.addEventListener('click', () => {
					const grupo = grupoDe(boton);
					const opcion = boton.dataset.opcion!;
					cambiar('unica' in boton.dataset ? elegirSolo(filtro, grupo, opcion) : alternar(filtro, grupo, opcion));
				});
			}
			limpiar.addEventListener('click', () => {
				buscador.value = '';
				cambiar({ ...FILTRO_VACIO, orden: filtro.orden });
				buscador.focus();
			});
			aplicar(false);
		}
	}

	customElements.define('lista-problemas', ListaProblemas);
</script>

<style>
	.ejercicios {
		display: block;
		margin-top: 1rem;
	}

	/* ---------- Buscador y orden ---------- */
	.barra {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
	}
	.buscador {
		display: flex;
		flex: 1 1 18rem;
		gap: 0.6rem;
		align-items: center;
		max-width: 28rem;
		padding: 0.65rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: var(--sl-color-gray-3);
	}
	.buscador:focus-within {
		border-color: var(--sl-color-accent);
	}
	input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
	}
	input::placeholder {
		color: var(--sl-color-gray-3);
	}
	.orden {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-2);
	}
	select {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
		cursor: pointer;
	}

	/* ---------- Pestañas de dificultad ---------- */
	.pestanas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 1.5rem;
		border-bottom: 1px solid var(--sl-color-gray-6);
	}
	.pestanas button {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		margin-bottom: -1px;
		padding: 0.6rem 1rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-weight: 500;
		cursor: pointer;
	}
	.pestanas button:hover:not(:disabled) {
		color: var(--sl-color-white);
	}
	.pestanas button[aria-pressed='true'] {
		border-bottom-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.pestanas button:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.pestanas .punto {
		width: 0.6rem;
		height: 0.6rem;
		border: 1px solid var(--dificultad-borde);
		border-radius: 50%;
		background: var(--dificultad-texto);
	}
	.cuenta {
		padding: 0 0.45rem;
		border-radius: 999rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-2xs);
		font-weight: 500;
