---
// Catálogo completo de conceptos, agrupados por dominio y área, con buscador.
// (Los problemas tienen su propia lista, con filtro por conceptos: ListaProblemas.)
import { Icon } from '@astrojs/starlight/components';
import TarjetaPagina from './TarjetaPagina.astro';
import { agruparConceptos, normalizar } from '../lib/menu';
import { obtenerPaginas, type PaginaContenido } from '../lib/paginas';

const { conceptos } = await obtenerPaginas();

const dominios = agruparConceptos(conceptos).map((d) => ({
	titulo: d.dominio,
	grupos: d.areas.map((g) => ({
		titulo: g.area,
		cuenta: `${g.conceptos.length} ${g.conceptos.length === 1 ? 'concepto' : 'conceptos'}`,
		paginas: g.conceptos,
	})),
}));

const textoDe = (p: PaginaContenido) =>
	normalizar([p.etiqueta, p.descripcion, ...p.temas, p.area, p.dominio].filter(Boolean).join(' '));
---

<catalogo-paginas class="catalogo not-content">
	<div class="filtros">
		<label class="buscador">
			<Icon name="magnifier" size="1.1rem" />
			<span class="sr-only">Buscar conceptos</span>
			<input type="search" placeholder="Buscar por nombre o tema" autocomplete="off" data-buscador />
		</label>
		<p class="recuento" aria-live="polite" data-recuento>{conceptos.length} conceptos</p>
	</div>

	{
		dominios.map((dominio) => (
			<section class="dominio" data-dominio>
				<h2 class="titulo-dominio">{dominio.titulo}</h2>
				<div class="tablero">
					{dominio.grupos.map((grupo) => (
						<section class="area" data-grupo>
							<h3>
								{grupo.titulo}
								<span class="cuenta">{grupo.cuenta}</span>
							</h3>
							<ul class="lista">
								{grupo.paginas.map((pagina) => (
									<TarjetaPagina pagina={pagina} compacta data-texto={textoDe(pagina)} />
								))}
							</ul>
						</section>
					))}
				</div>
			</section>
		))
	}

	<p class="vacio" hidden data-vacio>Ningún concepto coincide con la búsqueda.</p>
</catalogo-paginas>

<script>
	import { normalizar } from '../lib/menu';

	class CatalogoPaginas extends HTMLElement {
		connectedCallback() {
			const buscador = this.querySelector<HTMLInputElement>('[data-buscador]')!;
			const tarjetas = [...this.querySelectorAll<HTMLElement>('li[data-texto]')];
			const grupos = [...this.querySelectorAll<HTMLElement>('[data-grupo]')];
			const dominios = [...this.querySelectorAll<HTMLElement>('[data-dominio]')];
			const recuento = this.querySelector<HTMLElement>('[data-recuento]')!;
			const vacio = this.querySelector<HTMLElement>('[data-vacio]')!;

			buscador.addEventListener('input', () => {
				const palabras = normalizar(buscador.value.trim()).split(/\s+/).filter(Boolean);
				let visibles = 0;
				for (const tarjeta of tarjetas) {
					tarjeta.hidden = !palabras.every((p) => tarjeta.dataset.texto!.includes(p));
					if (!tarjeta.hidden) visibles++;
				}
				for (const grupo of grupos) grupo.hidden = !grupo.querySelector('li[data-texto]:not([hidden])');
				for (const dominio of dominios) dominio.hidden = !dominio.querySelector('[data-grupo]:not([hidden])');
				vacio.hidden = visibles > 0;
				recuento.textContent =
					visibles === tarjetas.length ? `${tarjetas.length} conceptos` : `${visibles} de ${tarjetas.length} conceptos`;
			});
		}
	}

	customElements.define('catalogo-paginas', CatalogoPaginas);
</script>

<style>
	.catalogo {
		display: block;
		margin-top: 1rem;
	}
	.filtros {
		display: grid;
		gap: 0.9rem;
		margin-bottom: 0.5rem;
	}
	.buscador {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		max-width: 28rem;
		padding: 0.65rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: var(--sl-color-gray-3);
	}
	.buscador:focus-within {
		border-color: var(--sl-color-accent);
	}
	input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
	}
	input::placeholder {
		color: var(--sl-color-gray-3);
	}
	.recuento {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	/* Un bloque por dominio, con su título encima del tablero de sus áreas. */
	.dominio {
		margin-top: 2.25rem;
	}
	.dominio[hidden] {
		display: none;
	}
	.titulo-dominio {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	/* Tablero: una fila por área, a todo el ancho, con sus tarjetas una al lado de
	   otra (cuatro en escritorio). Al añadir conceptos, las tarjetas pasan a la
	   línea siguiente; al añadir áreas, aparecen más filas debajo. */
	.tablero {
		display: grid;
		gap: 1.25rem;
		margin-top: 1rem;
	}
	.area {
		display: grid;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: calc(var(--euler-radio) * 1.5);
		background: var(--sl-color-gray-7);
	}
	.area[hidden] {
		display: none;
	}
	h3 {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.cuenta {
		font-size: var(--sl-text-xs);
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	.lista {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.vacio {
		margin-top: 2rem;
		color: var(--sl-color-gray-2);
	}
</style>
