---
// La ruta de un track: sus conceptos por niveles, de los que no necesitan nada
// a los que se apoyan en los anteriores. Los conceptos previos de otras rutas se
// indican en cada tarjeta.
import { obtenerGrafo, urlDe } from '../../lib/relaciones';
import { trackDeDominio } from '../../lib/tracks';
import { urlDeTrack, type DatosTrack } from '../../lib/rutas';

interface Props {
	datos: DatosTrack;
}

const { datos } = Astro.props;
const grafo = await obtenerGrafo();
const etiquetaDe = (id: string) => grafo.nodos.get(id)?.etiqueta ?? id;
const trackDe = (id: string) => trackDeDominio(grafo.nodos.get(id)?.dominio);
const usos = (id: string) => (grafo.nodos.get(id)?.hijos ?? []).filter((h) => grafo.nodos.get(h)?.tipo === 'problema').length;
---

<ol class="ruta not-content">
	{
		datos.ruta.map((pasos, nivel) => (
			<li class="nivel">
				<h2>
					<span class="numero">{nivel + 1}</span>
					{nivel === 0 ? 'Para empezar' : `Nivel ${nivel + 1}`}
				</h2>
				<ul class="conceptos">
					{pasos.map(({ concepto, deOtraRuta }) => (
						<li>
							<a href={concepto.href} class="concepto">
								<span class="titulo">{concepto.etiqueta}</span>
								<span class="area">{concepto.area}</span>
								{concepto.descripcion && <span class="descripcion">{concepto.descripcion}</span>}
								<span class="pie">
									{usos(concepto.id)} {usos(concepto.id) === 1 ? 'ejercicio' : 'ejercicios'}
								</span>
							</a>
							{deOtraRuta.length > 0 && (
								<p class="otra-ruta">
									Necesita también{' '}
									{deOtraRuta.map((id, i) => (
										<>
											{i > 0 && ', '}
											<a href={urlDe(id)}>{etiquetaDe(id)}</a>
											{trackDe(id) && (
												<>
													{' '}
													(<a href={urlDeTrack(trackDe(id)!)}>{trackDe(id)!.dominio}</a>)
												</>
											)}
										</>
									))}
								</p>
							)}
						</li>
					))}
				</ul>
			</li>
		))
	}
</ol>

<style>
	.ruta {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	h2 {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		margin: 0 0 1rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.numero {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--sl-color-accent);
		color: #ffffff;
		font-size: var(--sl-text-sm);
	}
	.conceptos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.concepto {
		display: grid;
		gap: 0.4rem;
		height: 100%;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: inherit;
		text-decoration: none;
	}
	.concepto:hover {
		border-color: var(--sl-color-accent);
	}
	.titulo {
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.area {
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.descripcion {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.pie {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.otra-ruta {
		margin: 0.5rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
</style>
