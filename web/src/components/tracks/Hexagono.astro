---
// Icono hexagonal de un track, como los de los lenguajes de Exercism.
interface Props {
	glifo: string;
	tamano?: number;
}

const { glifo, tamano = 64 } = Astro.props;
---

<span class="hexagono" style={`--tamano: ${tamano}px`} aria-hidden="true">
	<svg viewBox="0 0 100 100" width={tamano} height={tamano}>
		<polygon points="50,4 91,27 91,73 50,96 9,73 9,27" />
	</svg>
	<span class="glifo">{glifo}</span>
</span>

<style>
	.hexagono {
		position: relative;
		display: inline-grid;
		flex-shrink: 0;
		place-items: center;
		width: var(--tamano);
		height: var(--tamano);
	}
	svg {
		position: absolute;
		inset: 0;
	}
	polygon {
		fill: var(--sl-color-accent-low);
		stroke: var(--sl-color-accent);
		stroke-width: 5;
		stroke-linejoin: round;
	}
	.glifo {
		position: relative;
		color: var(--sl-color-accent-high);
		font-size: calc(var(--tamano) * 0.36);
		font-weight: 700;
		line-height: 1;
	}
</style>
