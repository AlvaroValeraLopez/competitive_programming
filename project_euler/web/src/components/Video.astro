---
// Vídeo generado con Manim (ver ../videos). Los archivos viven en public/videos/
// y se copian ahí con `uv run python render.py`.
interface Props {
	/** Nombre del archivo en public/videos/, por ejemplo "suma-de-gauss.mp4". */
	archivo: string;
	/** Descripción del contenido, para lectores de pantalla. */
	titulo: string;
	pie?: string;
}

const { archivo, titulo, pie } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/videos/${archivo}`;
---

<figure class="video not-content">
	<video controls playsinline preload="metadata" aria-label={titulo}>
		<source src={src} type="video/mp4" />
	</video>
	{pie && <figcaption>{pie}</figcaption>}
</figure>

<style>
	.video {
		margin-block: 1.5rem;
	}
	video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 0.75rem;
		background: hsl(224, 10%, 10%);
	}
	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
