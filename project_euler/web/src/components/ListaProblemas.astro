---
// Página de problemas al estilo de la lista de ejercicios de Exercism: tarjetas
// con el número, el título, la descripción y los conceptos que usa cada
// problema, con buscador y filtro por conceptos. El filtro se guarda en la
// dirección (`?conceptos=a,b&q=…`), así que una selección de conceptos es una
// página que se puede enlazar.
import { Icon } from '@astrojs/starlight/components';
import { agruparConceptos, agruparProblemas, normalizar } from '../lib/menu';
import { obtenerPaginas } from '../lib/paginas';
import { obtenerGrafo } from '../lib/relaciones';

const { problemas, conceptos } = await obtenerPaginas();
const grafo = await obtenerGrafo();

const slug = (id: string) => id.replace(/^conceptos\//, '');
const etiquetaDe = new Map(conceptos.map((c) => [c.id, c.etiqueta]));
const conceptosDe = (id: string) => grafo.nodos.get(id)?.padres ?? [];
const usos = (concepto: string) => problemas.filter((p) => conceptosDe(p.id).includes(concepto)).length;

// Solo se ofrecen como filtro los conceptos que usa algún problema, agrupados por área.
const areas = agruparConceptos(conceptos)
	.map((g) => ({ area: g.area, conceptos: g.conceptos.filter((c) => usos(c.id) > 0) }))
	.filter((g) => g.conceptos.length > 0);

const decenas = agruparProblemas(problemas);
const total = problemas.length;
---

<lista-problemas class="ejercicios not-content">
	<div class="barra">
		<label class="buscador">
			<Icon name="magnifier" size="1.1rem" />
			<span class="sr-only">Buscar problemas</span>
			<input type="search" placeholder="Buscar por número o título" autocomplete="off" data-buscador />
		</label>
		<p class="recuento" aria-live="polite" data-recuento>{total} problemas</p>
	</div>

	<fieldset class="filtro-conceptos">
		<legend>Practicar por conceptos</legend>
		{
			areas.map((grupo) => (
				<div class="area">
					<span class="nombre-area">{grupo.area}</span>
					<div class="chips">
						{grupo.conceptos.map((c) => (
							<button type="button" aria-pressed="false" data-concepto={slug(c.id)}>
								{c.etiqueta}
								<span class="usos">{usos(c.id)}</span>
							</button>
						))}
					</div>
				</div>
			))
		}
		<button type="button" class="limpiar" hidden data-limpiar>
			<Icon name="close" size="0.9rem" />
			Quitar filtros
		</button>
	</fieldset>

	<div class="rejilla" data-rejilla>
		{
			decenas.map((d) => (
				<>
					<h2 class="decena" data-decena>
						{d.etiqueta}
						<span>{d.problemas.length} de 10</span>
					</h2>
					{d.problemas.map((p) => {
						const usados = conceptosDe(p.id);
						return (
							<article
								class="ejercicio"
								data-ejercicio
								data-numero={p.numero}
								data-texto={normalizar([p.numero, p.etiqueta, p.descripcion, ...p.temas].filter(Boolean).join(' '))}
								data-conceptos={usados.map(slug).join(' ')}
							>
								<span class="numero" aria-hidden="true">
									{p.numero}
								</span>
								<div class="cuerpo">
									<h3>
										<a href={p.href} class="enlace">
											<span class="sr-only">Problema {p.numero}: </span>
											{p.etiqueta}
										</a>
									</h3>
									{p.descripcion && <p class="descripcion">{p.descripcion}</p>}
									{usados.length > 0 && (
										<ul class="usa" aria-label="Conceptos que usa">
											{usados.map((c) => (
												<li>
													<button type="button" data-concepto={slug(c)} title="Filtrar por este concepto">
														{etiquetaDe.get(c)}
													</button>
												</li>
											))}
										</ul>
									)}
								</div>
							</article>
						);
					})}
				</>
			))
		}
	</div>

	<p class="vacio" hidden data-vacio>Ningún problema coincide con el filtro.</p>
</lista-problemas>

<script>
	import { alternarConcepto, escribirFiltro, filtrar, hayFiltro, leerFiltro, type Filtro } from '../lib/filtro';

	class ListaProblemas extends HTMLElement {
		connectedCallback() {
			const buscador = this.querySelector<HTMLInputElement>('[data-buscador]')!;
			const recuento = this.querySelector<HTMLElement>('[data-recuento]')!;
			const rejilla = this.querySelector<HTMLElement>('[data-rejilla]')!;
			const vacio = this.querySelector<HTMLElement>('[data-vacio]')!;
			const limpiar = this.querySelector<HTMLButtonElement>('[data-limpiar]')!;
			const botones = [...this.querySelectorAll<HTMLButtonElement>('button[data-concepto]')];
			const tarjetas = [...this.querySelectorAll<HTMLElement>('[data-ejercicio]')].map((elemento) => ({
				elemento,
				numero: Number(elemento.dataset.numero),
				texto: elemento.dataset.texto!,
				conceptos: elemento.dataset.conceptos!.split(' ').filter(Boolean),
			}));
			const conocidos = new Set(botones.map((b) => b.dataset.concepto!));

			let filtro: Filtro = leerFiltro(location.search, conocidos);
			buscador.value = filtro.consulta;

			const aplicar = (guardar = true) => {
				const activo = hayFiltro(filtro);
				const visibles = filtrar(tarjetas, filtro);
				for (const t of tarjetas) {
					t.elemento.hidden = true;
					t.elemento.style.order = '';
				}
				// Con filtro, las tarjetas se reordenan por relevancia (CSS `order`) y
				// se ocultan las cabeceras de las decenas.
				visibles.forEach((t, i) => {
					t.elemento.hidden = false;
					if (activo) t.elemento.style.order = String(i);
				});
				rejilla.classList.toggle('filtrando', activo);
				for (const b of botones) b.setAttribute('aria-pressed', String(filtro.conceptos.includes(b.dataset.concepto!)));
				vacio.hidden = visibles.length > 0;
				limpiar.hidden = !activo;
				recuento.textContent =
					visibles.length === tarjetas.length
						? `${tarjetas.length} problemas`
						: `${visibles.length} de ${tarjetas.length} problemas`;
				if (guardar) history.replaceState(history.state, '', location.pathname + escribirFiltro(filtro) + location.hash);
			};

			buscador.addEventListener('input', () => {
				filtro = { ...filtro, consulta: buscador.value };
				aplicar();
			});
			for (const boton of botones) {
				boton.addEventListener('click', () => {
					filtro = alternarConcepto(filtro, boton.dataset.concepto!);
					aplicar();
				});
			}
			limpiar.addEventListener('click', () => {
				filtro = { conceptos: [], consulta: '' };
				buscador.value = '';
				aplicar();
				buscador.focus();
			});
			aplicar(false);
		}
	}

	customElements.define('lista-problemas', ListaProblemas);
</script>

<style>
	.ejercicios {
		display: block;
		margin-top: 1rem;
	}

	.barra {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
	}
	.buscador {
		display: flex;
		flex: 1 1 18rem;
		gap: 0.6rem;
		align-items: center;
		max-width: 28rem;
		padding: 0.65rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: var(--sl-color-gray-3);
	}
	.buscador:focus-within {
		border-color: var(--sl-color-accent);
	}
	input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
	}
	input::placeholder {
		color: var(--sl-color-gray-3);
	}
	.recuento {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-2);
	}

	.filtro-conceptos {
		display: grid;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: var(--euler-radio);
		background: var(--sl-color-gray-7);
	}
	legend {
		float: left;
		margin-bottom: 0.25rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.area {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
	}
	.nombre-area {
		min-width: 9.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chips button {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.35rem 0.5rem 0.35rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-1);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		cursor: pointer;
	}
	.chips button:hover {
		border-color: var(--sl-color-accent);
	}
	.usos {
		min-width: 1.4rem;
		padding: 0 0.35rem;
		border-radius: 999rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-2xs);
		text-align: center;
	}
	.chips button[aria-pressed='true'] {
		border-color: var(--euler-boton-borde);
		background: var(--sl-color-accent);
		color: #ffffff;
	}
	.chips button[aria-pressed='true'] .usos {
		background: rgba(255, 255, 255, 0.25);
	}
	.limpiar {
		display: inline-flex;
		gap: 0.35rem;
		align-items: center;
		justify-self: start;
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		cursor: pointer;
	}
	.limpiar[hidden] {
		display: none;
	}

	.rejilla {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
		gap: 1rem 1.25rem;
		margin-top: 0.5rem;
	}
	.decena {
		display: flex;
		grid-column: 1 / -1;
		gap: 0.75rem;
		align-items: baseline;
		margin: 1.5rem 0 0;
		font-size: var(--sl-text-2xl);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.decena span {
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	.filtrando .decena {
		display: none;
	}
	.filtrando {
		margin-top: 1.5rem;
	}

	.ejercicio {
		position: relative;
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		transition:
			box-shadow 0.15s,
			border-color 0.15s;
	}
	.ejercicio[hidden] {
		display: none;
	}
	.ejercicio:hover,
	.ejercicio:focus-within {
		border-color: var(--sl-color-accent);
		box-shadow: var(--euler-sombra-grande);
	}
	.numero {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border: 1px solid var(--euler-boton-borde);
		border-radius: var(--euler-radio);
		background: var(--sl-color-accent);
		color: #ffffff;
		font-size: var(--sl-text-lg);
		font-weight: 700;
	}
	.cuerpo {
		display: grid;
		gap: 0.4rem;
		min-width: 0;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
	}
	.enlace {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	/* Toda la tarjeta lleva al problema; las etiquetas de conceptos quedan por encima. */
	.enlace::after {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		content: '';
	}
	.descripcion {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.usa {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}
	.usa button {
		position: relative;
		z-index: 1;
		padding: 0.15rem 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-1);
		font: inherit;
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		cursor: pointer;
	}
	.usa button:hover {
		border-color: var(--sl-color-accent);
	}
	.usa button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}

	.vacio {
		margin-top: 2rem;
		color: var(--sl-color-gray-2);
	}
</style>
