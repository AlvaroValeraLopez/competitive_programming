---
// Rejilla de tarjetas generada a partir de las páginas de una carpeta, al
// estilo de las tarjetas de ejercicios de Exercism. Se actualiza sola al
// añadir páginas.
import { getCollection } from 'astro:content';

interface Props {
	directorio: 'problemas' | 'conceptos';
}

const { directorio } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const paginas = (await getCollection('docs', ({ id }) => id.startsWith(`${directorio}/`)))
	.sort((a, b) => (a.data.sidebar.order ?? 0) - (b.data.sidebar.order ?? 0))
	.map(({ id, data }) => ({
		href: `${base}/${id}/`,
		numero: directorio === 'problemas' ? data.sidebar.order : undefined,
		titulo: data.title.replace(/^Problema \d+:\s*/, ''),
		descripcion: data.description,
		temas: data.temas ?? [],
	}));
---

<ul class:list={['tarjetas', 'not-content', directorio]}>
	{
		paginas.map(({ href, numero, titulo, descripcion, temas }) => (
			<li>
				<a href={href}>
					<span class="cabecera">
						{numero !== undefined && <span class="numero">{numero}</span>}
						<span class="titulo">{titulo}</span>
					</span>
					{descripcion && <span class="descripcion">{descripcion}</span>}
					{temas.length > 0 && (
						<span class="temas">
							{temas.map((tema) => (
								<span>{tema}</span>
							))}
						</span>
					)}
				</a>
			</li>
		))
	}
</ul>

<style>
	.tarjetas {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1.25rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		height: 100%;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: var(--euler-radio);
		background: var(--sl-color-black);
		box-shadow: var(--euler-sombra);
		color: var(--sl-color-text);
		text-decoration: none;
		transition:
			box-shadow 0.15s,
			border-color 0.15s,
			transform 0.15s;
	}
	a:hover {
		border-color: var(--sl-color-accent);
		box-shadow: var(--euler-sombra-grande);
		transform: translateY(-2px);
	}
	.cabecera {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	.numero {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--euler-radio);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 700;
	}
	.titulo {
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.descripcion {
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.temas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: auto;
	}
	.temas span {
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999rem;
		font-size: var(--sl-text-2xs);
		font-weight: 500;
		color: var(--sl-color-gray-1);
	}
	.conceptos a {
		padding: 1rem 1.25rem;
	}
</style>
