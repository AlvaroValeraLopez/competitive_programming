---
// Rejilla de tarjetas de la portada: las primeras páginas de una carpeta y un
// enlace a su catálogo completo. Se actualiza sola al añadir páginas.
import TarjetaPagina from '../TarjetaPagina.astro';
import { obtenerPaginas, urlDe } from '../../lib/paginas';

interface Props {
	directorio: 'problemas' | 'conceptos';
	/** Cuántas tarjetas mostrar como máximo. */
	limite?: number;
}

const { directorio, limite = 6 } = Astro.props;
const todas = (await obtenerPaginas())[directorio];
const paginas = todas.slice(0, limite);
---

<ul class="rejilla-tarjetas not-content">
	{paginas.map((pagina) => <TarjetaPagina pagina={pagina} compacta={directorio === 'conceptos'} />)}
</ul>
<p class="ver-todos not-content">
	<a href={urlDe(directorio)}>
		{`Ver ${todas.length > paginas.length ? `los ${todas.length}` : 'todos los'} ${directorio} `}
		<span aria-hidden="true">→</span>
	</a>
</p>

<style>
	.ver-todos {
		margin: 1.25rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.ver-todos a {
		color: var(--sl-color-text-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.ver-todos a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
